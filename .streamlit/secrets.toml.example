# Example Streamlit Secrets Configuration
# Copy this to your Streamlit Cloud app's secrets section
# DO NOT commit this file with real values to GitHub

[firebase_web]
apiKey = "AIzaSyDoJHKV1vHiBBMWm3ZnJqG7h_Cs7pdLYGg"
authDomain = "promptbuddy-app.firebaseapp.com"
projectId = "promptbuddy-app"
storageBucket = "promptbuddy-app.firebasestorage.app"
messagingSenderId = "376239818434"
appId = "1:376239818434:web:f339c2b00e6808d5909d5b"
measurementId = "G-JT6B0G92TJ"

# Firebase Admin SDK Service Account
# Replace these with values from your serviceAccountKey.json
[firebase_admin]
type = "service_account"
project_id = "promptbuddy-app"
private_key_id = "YOUR_PRIVATE_KEY_ID_HERE"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
client_email = "firebase-adminsdk-xxxxx@promptbuddy-app.iam.gserviceaccount.com"
client_id = "YOUR_CLIENT_ID_HERE"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "YOUR_CERT_URL_HERE"

# Optional: Default Gemini API Key
[gemini]
api_key = "YOUR_GEMINI_API_KEY_HERE"
